#version 460
#extension GL_GOOGLE_include_directive : enable
#include "mpm_structs.glsl"

/**
 * 粒子级硬冻结（每子步，对标 PhysDreamer gui_demo.py:313-318）
 *   nxt_x[freeze_mask] = freeze_init_x[freeze_mask]
 *   nxt_v[freeze_mask] = 0
 *
 * 硬钉 position + velocity，**并重置 F=I、C=0**。
 *
 * 与 PD 的差异：PD gui_demo.py:317-318 只钉 x/v，不动 F/C。PD 能这样做是因为其
 * 冻结壳足够厚，冻结粒子的 3x3x3 支撑节点几乎全被 grid_freeze 零化 → ∇v≈0 →
 * F≈I/C≈0 自然保持。我们的 carnation 冻结壳仅 ~2 格厚 + grid_freeze 只冻单节点，
 * 冻结粒子其余 26 节点常有非零速度 → ∇v≠0 → F 漂移到 1.67 → 注入 tau=6.2M
 * 虚假应力 → 全场 F 爆炸（实测：移除重置后 max|F-R| 0.21→1.67，max_tau 320k→6.2M）。
 * 故必须显式重置 F=I、C=0 切断虚假应力源。这是我们对 PD 的必要补丁。
 *
 * 流程位置：G2P 之后（每子步末尾）。
 */
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    ParticleData particles[];
};

// 初始位置（vec4 stride=16，与 initial_pos_buffer_ 上传格式一致）
layout(std430, set = 0, binding = 1) readonly buffer InitPosBuffer {
    vec4 init_pos[];
};

layout(push_constant) uniform PinParams {
    uint num_particles;  // offset 0
    uint _pad[3];        // offset 4,8,12 (16 字节对齐)
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_particles) return;

    // 只处理冻结粒子
    if (particles[idx].freeze_flag == 0u) return;

    // 硬钉：位置=初始，速度=0（对标 PD gui_demo.py:317-318）
    particles[idx].position = init_pos[idx].xyz;
    particles[idx].velocity = vec3(0.0);

    // 刚性锚点不变形：F=I、APIC C=0。切断冻结粒子的永久虚假应力源
    // （我们的单节点 grid_freeze 不足以保持 F≈I，必须显式重置）。
    particles[idx].deformation_gradient = mat3(1.0);
    particles[idx].apic_matrix = mat3(0.0);
}
