#version 460
#extension GL_GOOGLE_include_directive : enable
#include "../mpm/mpm_structs.glsl"

/**
 * 拖拽速度 Dirichlet BC（每子步执行，对标 PhysDreamer enforce_particle_velocity_by_mask）
 *
 * PhysDreamer gui_demo.py:295-306 每帧重挂 enforce_particle_velocity_by_mask，
 * 其 modify_particle_v_before_p2g 每子步在 P2G 前 SET particle_v = grab_velocity（半径内掩码粒子）。
 * 旧实现 DragHandler 每帧一次 + alpha=0.2 blend → 速度扩散后 batch 停止，变形微弱。
 * 本 shader 每子步 SET（非 blend）半径内非冻结粒子速度 = dragVelocity，持续驱动 batch 跟随鼠标，
 * 与周围非拖拽粒子形成持续速度梯度 → 局部变形 → 非均匀 F → 弹性回弹。
 *
 * 流程位置：ZeroGrid 之后、P2G 之前（对标 pre_p2g_operations）。
 *
 * Push constant (48 bytes, 与 DragPushConstants 布局一致):
 *   vec3 center; float radius; vec3 velocity; float alpha; int isDragging; float maxVelocity; int pad[2]
 */
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    ParticleData particles[];
};

layout(push_constant) uniform DragBC {
    vec3  center;        // offset 0  拖拽中心（归一化空间）
    float radius;        // offset 12 拖拽半径（归一化空间）
    vec3  velocity;      // offset 16 拖拽目标速度（归一化空间/s）
    float alpha;         // offset 28 (未用，SET 模式)
    int   isDragging;    // offset 32 0=未拖拽 1=拖拽中
    float maxVelocity;   // offset 36 CFL 速度上限 (0=不限制)
    uint  numParticles;  // offset 40 粒子数（边界检查，避免依赖 SSBO length/stride）
    int   pad1;          // offset 44
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.numParticles) return;
    if (pc.isDragging == 0) return;

    // 冻结粒子不拖（锚点保持）
    if (particles[idx].freeze_flag != 0u) return;

    vec3 p = particles[idx].position;
    float dist = distance(p, pc.center);
    if (dist > pc.radius) return;

    // 对标 PhysDreamer: SET velocity = grab_velocity（Dirichlet BC，硬掩码半径内统一）
    // 不做距离衰减 blend —— 持续硬驱动 batch 跟随鼠标，弹性在边界形成变形梯度。
    vec3 v = pc.velocity;

    // CFL 限幅：|v|*sub_dt <= 0.5*dx，防一子步射出网格
    if (pc.maxVelocity > 0.0) {
        float mag = length(v);
        if (mag > pc.maxVelocity && mag > 1e-12) {
            v *= pc.maxVelocity / mag;
        }
    }

    // ── 应变门控：把变形控制在弹性范围内（硬截断，非塑性）──
    // 设计意图（Joe）：弹性范围内跟随鼠标形变；用户加大力度越过弹性上限 → 批次停止跟随
    // （不再注入拖拽速度，鼠标继续移动也拽不动），FCR 弹性应力把已变形拉回。不引入屈服/塑性。
    //
    // 拖拽爆炸根因：批次边界粒子 ∇v 持续 256 子步 → F 累积变形到奇异 → τ·∇w 甩飞边界粒子。
    // CFL 只防"单子步射出"，不防"累积应变"。此处按粒子自身 F 的变形量衰减注入速度：
    //   弹性范围内 deform < SOFT → gate=1 全速跟随鼠标；
    //   越过 HARD → gate=0 停止驱动 → 应变前缘向内传播 → 整批饱和在弹性上限 → 不再跟随。
    //
    // 变形指标 deform = max(列范数, 1/|det|)：兼顾拉伸与压缩两种失效模式。
    //   列范数 max|F[:,i]| = 拉伸比（F=R·S，|列|=|S 列|，旋转不变）—— 捕获拉伸撕裂；
    //   1/|J| = 压缩比（J<1 时 >1）—— 捕获体积塌缩/内翻（实测主导失效模式：min_det 跌到 0.09）。
    //   纯旋转 F=R → 列范数=1 且 J=1 → deform=1 不触发（刚体旋转不受限）。
    // 阈值标定：日志爆炸点 max|F-R|=1.10≈单轴 λ-1→λ=2.10=撕裂点；min_det=0.09→1/J=11=塌缩点。
    //   弹性上限 HARD=1.5（50% 拉伸或 J=0.67 压缩，远低于撕裂/塌缩，可见形变但安全可恢复），
    //   SOFT=1.2 开始衰减（窄带平滑避免离散跳变致振荡）。
    mat3 F = particles[idx].deformation_gradient;
    float stretch = max(length(F[0]), max(length(F[1]), length(F[2])));
    float J = F[0][0]*(F[1][1]*F[2][2]-F[1][2]*F[2][1])
            - F[0][1]*(F[1][0]*F[2][2]-F[1][2]*F[2][0])
            + F[0][2]*(F[1][0]*F[2][1]-F[1][1]*F[2][0]);
    float compress = 1.0 / max(abs(J), 1e-4);   // J<1 时 >1，捕获压缩塌缩
    float deform = max(stretch, compress);
    float gate = 1.0 - smoothstep(1.2, 1.5, deform);  // 弹性硬截断
    if (J < 0.1) gate = 0.0;   // det 异常：内翻/塌缩，停止驱动让弹性拉回（compress 已>10，此为显式安全）
    v *= gate;
    // gate→0 时写入 0 速度：停止向该粒子注入能量，P2G 仅由应力力驱动 → FCR 弹性恢复接管。
    // 粒子位置仍由 G2P 网格速度更新（含弹性回拉），不会卡死。

    particles[idx].velocity = v;
}
