#version 460
layout(local_size_x = 1) in;

struct ParticleData {
    vec3 position;
    float mass;
    vec3 velocity;
    uint freeze_flag;
};

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    ParticleData particles[];
};

layout(push_constant) uniform MouseForceUniforms {
    uint target_particle_idx;
    vec3 force_vector;
    float max_velocity;
    float dt;
    uint padding[2];
};

void main() {
    if (gl_GlobalInvocationID.x != 0) {
        return;
    }

    if (target_particle_idx >= particles.length()) {
        return;
    }

    float mass = particles[target_particle_idx].mass;
    if (mass <= 0.0) {
        mass = 1.0;
    }

    vec3 impulse = force_vector * dt;
    vec3 delta_v = impulse / mass;

    vec3 current_velocity = particles[target_particle_idx].velocity;
    vec3 new_velocity = current_velocity + delta_v;

    float speed = length(new_velocity);
    if (speed > max_velocity) {
        new_velocity = normalize(new_velocity) * max_velocity;
    }

    particles[target_particle_idx].velocity = new_velocity;
}
